# Copia este archivo como .env y llena los valores reales
# NUNCA subas el .env real al repositorio

# Entorno de la aplicación - usar "production" en servidor real
APP_NAME=MarketWorld
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Logs - usar "warning" en producción para no llenar el disco
LOG_LEVEL=debug

# Base de datos - cambiar según el servidor
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketworld_db
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña_aqui

# Sanctum - incluir host y puerto del frontend local (5500/5173) y backend (8000)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5500,127.0.0.1:5500,localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# CORS - dominios frontend permitidos separados por coma, sin espacios
# Producción: usar solo el dominio real del frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:5500,http://127.0.0.1:5173
# Con sesión por cookies (Sanctum) debe estar en true
CORS_SUPPORTS_CREDENTIALS=true

# Contraseña inicial del admin - cambiar inmediatamente después del primer despliegue
ADMIN_DEFAULT_PASSWORD=CambiarEnProduccion2026!
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Usar true en producción (HTTPS). En local puede ser false si no hay HTTPS.
SESSION_SECURE_COOKIE=true
# Opciones: lax, strict, none
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
